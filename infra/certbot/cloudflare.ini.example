# Cloudflare API credentials for certbot DNS challenge
# Copy this file to cloudflare.ini and fill in your token.
# The token needs Zone:DNS:Edit permission for avdanstore.com.
# Create it at: https://dash.cloudflare.com/profile/api-tokens
#
# Keep this file OUT of git. It is listed in .gitignore.
dns_cloudflare_api_token = YOUR_CLOUDFLARE_API_TOKEN_HERE
