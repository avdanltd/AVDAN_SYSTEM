# Database
DATABASE_URL=postgresql+asyncpg://avdan:avdan_dev@localhost:5432/avdan_test

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security — minimum 32 characters
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars

# Payment
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# App
ENVIRONMENT=development
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Platform config
COMMISSION_RATE_PERCENT=10
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


resend_api_key=your-resend-api-key-here
email_from=AVDAN <noreply@avdanstore.com>

# Object storage — Cloudflare R2 (S3-compatible)
# Account ID is the hex string in your Cloudflare dashboard URL.
# The API token needs Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN origin bound to the bucket. Stored image URLs are built from this,
# so changing it later breaks every URL already in the database.
# WARNING: this domain serves the ENTIRE bucket, including the private qa-evidence/ prefix.
# A Cloudflare WAF rule blocking /qa-evidence/* on this hostname is REQUIRED — see
# BACKLOG_HARMONISATION.md §2.
R2_PUBLIC_BASE_URL=https://cdn.avdanstore.com
# Max accepted upload size in bytes (8 MB).
MAX_UPLOAD_BYTES=8388608
