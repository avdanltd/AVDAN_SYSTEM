EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws
# Android build-time only (react-native-maps wraps native Google Maps on Android; not needed
# on iOS, which defaults to Apple Maps). Without it the live map's map tiles are blank grey on
# Android. Not prefixed EXPO_PUBLIC_ since app.config.ts reads it in Node, not in the JS bundle.
GOOGLE_MAPS_API_KEY_ANDROID=
